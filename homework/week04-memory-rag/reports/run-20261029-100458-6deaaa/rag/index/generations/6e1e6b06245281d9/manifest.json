        "source_sha256",
        "content_sha256",
        "version"
      ],
      "relationships": {},
      "metadata_template": "{key}: {value}",
      "metadata_separator": "\n",
      "text": "- 用户发起请求后，服务在响应返回前刷新 `expires_at`。\n- 新的到期时间 = 请求到达时刻 + 20 分钟。",
      "mimetype": "text/plain",
      "start_char_idx": null,
      "end_char_idx": null,
      "text_template": "{metadata_str}\n\n{content}",
      "class_name": "TextNode"
    },
